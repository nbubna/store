{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "vitest"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    "eqeqeq": "error",
    "no-unused-vars": "error",
    "curly": "error",
    "no-var": "off"
  },
  "overrides": [
    {
      "files": [
        "src/extensions/on.ts",
        "src/extensions/onlyreal.ts",
        "src/extensions/quota.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "libs/**",
    "node_modules/**",
    "scripts/**",
    "*.config.ts",
    "vite.extensions.config.ts"
  ],
}
