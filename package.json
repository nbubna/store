{
  "name": "store2",
  "version": "2.14.4",
  "description": "Better localStorage",
  "keywords": [
    "localStorage",
    "sessionStorage",
    "json",
    "namespace",
    "store"
  ],
  "author": {
    "name": "Nathan Bubna",
    "email": "nathan@esha.com",
    "url": "http://www.esha.com/"
  },
  "homepage": "https://github.com/nbubna/store#readme",
  "type": "module",
  "sideEffects": [
    "./dist/extensions/**",
    "./dist/store2.js",
    "./dist/store2.min.js"
  ],
  "files": [
    "dist",
    "MIGRATION-v3.md"
  ],
  "main": "./dist/store2.mjs",
  "module": "./dist/store2.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/store2.min.js",
  "jsdelivr": "./dist/store2.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/store2.mjs"
    },
    "./array": {
      "types": "./dist/extensions/array.d.ts",
      "default": "./dist/extensions/array.mjs"
    },
    "./async": {
      "types": "./dist/extensions/async.d.ts",
      "default": "./dist/extensions/async.mjs"
    },
    "./bind": {
      "types": "./dist/extensions/bind.d.ts",
      "default": "./dist/extensions/bind.mjs"
    },
    "./cache": {
      "types": "./dist/extensions/cache.d.ts",
      "default": "./dist/extensions/cache.mjs"
    },
    "./cookie": {
      "types": "./dist/extensions/cookie.d.ts",
      "default": "./dist/extensions/cookie.mjs"
    },
    "./cookies": {
      "types": "./dist/extensions/cookies.d.ts",
      "default": "./dist/extensions/cookies.mjs"
    },
    "./deep": {
      "types": "./dist/extensions/deep.d.ts",
      "default": "./dist/extensions/deep.mjs"
    },
    "./devalue": {
      "types": "./dist/extensions/devalue.d.ts",
      "default": "./dist/extensions/devalue.mjs"
    },
    "./dom": {
      "types": "./dist/extensions/dom.d.ts",
      "default": "./dist/extensions/dom.mjs"
    },
    "./dot": {
      "types": "./dist/extensions/dot.d.ts",
      "default": "./dist/extensions/dot.mjs"
    },
    "./proxy": {
      "types": "./dist/extensions/proxy.d.ts",
      "default": "./dist/extensions/proxy.mjs"
    },
    "./measure": {
      "types": "./dist/extensions/measure.d.ts",
      "default": "./dist/extensions/measure.mjs"
    },
    "./old": {
      "types": "./dist/extensions/old.d.ts",
      "default": "./dist/extensions/old.mjs"
    },
    "./on": {
      "types": "./dist/extensions/on.d.ts",
      "default": "./dist/extensions/on.mjs"
    },
    "./onlyreal": {
      "types": "./dist/extensions/onlyreal.d.ts",
      "default": "./dist/extensions/onlyreal.mjs"
    },
    "./overflow": {
      "types": "./dist/extensions/overflow.d.ts",
      "default": "./dist/extensions/overflow.mjs"
    },
    "./quota": {
      "types": "./dist/extensions/quota.d.ts",
      "default": "./dist/extensions/quota.mjs"
    }
  },
  "bugs": {
    "url": "http://github.com/nbubna/store/issues",
    "email": "nathan@esha.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nbubna/store.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build && BUILD_MIN=1 vite build && vite build --config vite.extensions.config.ts && node scripts/copy-extension-types.mjs",
    "prepublishOnly": "npm run build && npm test && git commit -m \"$npm_package_version\" README.md *.json dist && git tag $npm_package_version && git push && git push --tags",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "publint": "publint",
    "attw": "attw --pack .",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^0.16.0",
    "publint": "^0.3.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "devalue": "^5.8.1"
  }
}
