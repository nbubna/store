{
  "name": "store2",
  "version": "2.14.4",
  "description": "Better localStorage",
  "keywords": [
    "localStorage",
    "sessionStorage",
    "json",
    "namespace",
    "store"
  ],
  "author": {
    "name": "Nathan Bubna",
    "email": "nathan@esha.com",
    "url": "http://www.esha.com/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/store2.cjs",
  "module": "./dist/store2.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/store2.mjs",
      "require": "./dist/store2.cjs"
    },
    "./array": {
      "import": "./dist/extensions/array.mjs",
      "require": "./dist/extensions/array.cjs"
    },
    "./async": {
      "import": "./dist/extensions/async.mjs",
      "require": "./dist/extensions/async.cjs"
    },
    "./bind": {
      "import": "./dist/extensions/bind.mjs",
      "require": "./dist/extensions/bind.cjs"
    },
    "./cache": {
      "import": "./dist/extensions/cache.mjs",
      "require": "./dist/extensions/cache.cjs"
    },
    "./cookie": {
      "import": "./dist/extensions/cookie.mjs",
      "require": "./dist/extensions/cookie.cjs"
    },
    "./cookies": {
      "import": "./dist/extensions/cookies.mjs",
      "require": "./dist/extensions/cookies.cjs"
    },
    "./deep": {
      "import": "./dist/extensions/deep.mjs",
      "require": "./dist/extensions/deep.cjs"
    },
    "./dom": {
      "import": "./dist/extensions/dom.mjs",
      "require": "./dist/extensions/dom.cjs"
    },
    "./dot": {
      "import": "./dist/extensions/dot.mjs",
      "require": "./dist/extensions/dot.cjs"
    },
    "./measure": {
      "import": "./dist/extensions/measure.mjs",
      "require": "./dist/extensions/measure.cjs"
    },
    "./old": {
      "import": "./dist/extensions/old.mjs",
      "require": "./dist/extensions/old.cjs"
    },
    "./on": {
      "import": "./dist/extensions/on.mjs",
      "require": "./dist/extensions/on.cjs"
    },
    "./onlyreal": {
      "import": "./dist/extensions/onlyreal.mjs",
      "require": "./dist/extensions/onlyreal.cjs"
    },
    "./overflow": {
      "import": "./dist/extensions/overflow.mjs",
      "require": "./dist/extensions/overflow.cjs"
    },
    "./quota": {
      "import": "./dist/extensions/quota.mjs",
      "require": "./dist/extensions/quota.cjs"
    }
  },
  "bugs": {
    "url": "http://github.com/nbubna/store/issues",
    "email": "nathan@esha.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nbubna/store.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "vite build && BUILD_MIN=1 vite build && vite build --config vite.extensions.config.ts",
    "prepublishOnly": "npm run build && npm test && git commit -m \"$npm_package_version\" README.md *.json dist && git tag $npm_package_version && git push && git push --tags",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^0.16.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
